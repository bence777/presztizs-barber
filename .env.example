# Server-only secrets; never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder
SESSION_SIGNING_SECRET=
RATE_LIMIT_SECRET=
SITE_URL=https://demeters.hu
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=demeters.hu,www.demeters.hu
# This widget site key is intentionally public and is embedded at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Report-only first; enforce after the deployment's browser regression passes.
CSP_MODE=report-only
# Whole request defaults to 25s, upstream body+headers default to 8s.
HTTP_AUTH_TIMEOUT_MS=8000
HTTP_DATABASE_TIMEOUT_MS=8000
HTTP_RESEND_TIMEOUT_MS=8000
# Optional integer overrides; defaults: OTP IP=8/10min, pair=3/10min,
# email=5/10min; verify/password IP=25/10min, pair=10/10min;
# public reads=120/min, booking creation=10/user/10min, MFA=15/user/10min.
# RATE_SEND_CODE_IP_LIMIT=8
# RATE_OTP_EMAIL_LIMIT=5
# RATE_AVAILABILITY_IP_LIMIT=120
# RATE_BOOKING_CREATE_USER_LIMIT=10
